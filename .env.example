# ============================================================
# RiskControl Analyst (风险控制分析师) — environment template
# Copy to `.env` and fill in locally. NEVER commit a real `.env`.
# The whole app runs with ZERO keys: market data falls back to
# clearly-labelled local fixtures and the AI Analyst falls back to
# a deterministic planner.
# ============================================================

# ---------- API service ----------
RCA_ENV=local
RCA_HOST=127.0.0.1
RCA_PORT=8000
RCA_LOG_LEVEL=INFO
# Comma separated origins allowed to call the API from a browser
RCA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory holding the synthetic seed data and the runtime cache
RCA_DATA_DIR=../../data/synthetic
RCA_RUNTIME_DIR=./runtime

# Marks every dataset as synthetic demo material. Keep `true` for the
# public GitHub demo: no real company data may ever be shipped here.
RCA_SYNTHETIC_DATA=true

# ---------- Market data: FRED (optional) ----------
# Get a free key: https://fredaccount.stlouisfed.org/apikeys
# Without a key the Market Adapter serves local fixtures and marks
# `provenance.is_fixture = true`. It never invents live values.
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred
FRED_TIMEOUT_SECONDS=8
FRED_MAX_RETRIES=2
FRED_CACHE_TTL_SECONDS=3600
FRED_MIN_REQUEST_INTERVAL_SECONDS=0.5

# ---------- SEC EDGAR (designed, NOT implemented in v1) ----------
# The connector is deliberately unavailable: see docs/market-data-sources.md and
# GET /api/v1/market/edgar/status. These keys exist so the interface and the access
# policy are explicit. Filling them in does not enable data — v1 never calls SEC.
EDGAR_ENABLED=false
# The SEC fair-access policy requires a descriptive User-Agent with contact details.
EDGAR_USER_AGENT=
EDGAR_BASE_URL=https://data.sec.gov
EDGAR_ARCHIVE_URL=https://www.sec.gov
EDGAR_TIMEOUT_SECONDS=10
EDGAR_MAX_RETRIES=2
EDGAR_MIN_REQUEST_INTERVAL_SECONDS=0.2
EDGAR_CACHE_TTL_SECONDS=86400

# ---------- AI Analyst (optional) ----------
# Any OpenAI-compatible endpoint works. With no key configured the
# orchestrator uses the deterministic planner and says so in the
# response metadata (`engine: "deterministic-planner"`).
RCA_LLM_PROVIDER=deterministic
RCA_LLM_MODEL=
RCA_LLM_BASE_URL=
RCA_LLM_API_KEY=
RCA_LLM_TIMEOUT_SECONDS=30
RCA_LLM_MAX_OUTPUT_TOKENS=1200
# Tool-call audit log (JSONL). Contains arguments and timings, never secrets.
RCA_TOOL_LOG_PATH=./runtime/tool_calls.jsonl
